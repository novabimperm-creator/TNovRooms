<Window x:Class="TNovRooms.roomsBackupAnalyse"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovRooms"
        mc:Ignorable="d"
        Width="930"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:RoomsBackupAnalyseViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="АНАЛИЗ БЭКАПА"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="{Binding BackupName}"
                       Foreground="White"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBlock Text="Отображаются только помещения с отличиями в площадях."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Можно восстановить значения площадей всех помещений, либо выбрать восстановить для одного помещения (кнопки ниже)."
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"/>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Отмена"
                        x:Name="escButton"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="escButton_Click"/>
                <Button Grid.Column="2"
                        Content="Восстановить"
                        x:Name="acceptButton"
                        Style="{StaticResource RunButtonStyle}"
                        Margin="0"
                        IsDefault="True"
                        Click="acceptButton_Click"/>
            </Grid>

            <DataGrid x:Name="roomsGrid"
                      ItemsSource="{Binding Rows}"
                      Style="{StaticResource DarkDataGridStyle}"
                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      MaxHeight="350"
                      Margin="0">
                <DataGrid.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="{x:Type GroupItem}">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type GroupItem}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           Style="{StaticResource PanelHeaderStyle}"
                                                           Margin="0,8,0,4"/>
                                                <ItemsPresenter/>
                                            </StackPanel>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </DataGrid.GroupStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Категория"
                                        Binding="{Binding RoomCategory}"
                                        Width="80"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="№кв/офиса"
                                        Binding="{Binding RoomGroupNumber}"
                                        Width="80"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding RoomId}"
                                        Width="80"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding RoomName}"
                                        Width="150"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="S"
                                        Binding="{Binding RoomModelS}"
                                        Width="50"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Sк"
                                        Binding="{Binding RoomModelSK}"
                                        Width="50"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="S(б)"
                                        Binding="{Binding RoomBackupS}"
                                        Width="50"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTextColumn Header="Sк(б)"
                                        Binding="{Binding RoomBackupSK}"
                                        Width="50"
                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                    <DataGridTemplateColumn Header="Действие" Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Восстановить"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="8,4"
                                        FontSize="12"
                                        MinHeight="28"
                                        Tag="{Binding RoomId}"
                                        Click="replace_Click"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>
    </Border>
</Window>
