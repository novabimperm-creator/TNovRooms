<UserControl x:Class="TNovRooms.Manager.PlaceholderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TNovRooms.Manager"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="960"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ErrorCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="#FF6B6B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="⚙ Коэффициенты"
                       Style="{StaticResource PanelHeaderStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Площадь этажа можно взять из зоны или ввести вручную. «Обновить по зонам» заполняет N_Площадь этажа из выбранных зон; «Записать» записывает значения в помещения и закрывает окно."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="TbSummary"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="Обновить по зонам"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,6"
                    Margin="0,0,8,0"
                    MinHeight="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="UpdateFromZones_Click"/>
            <Button Grid.Column="2"
                    Content="Записать"
                    Style="{StaticResource RunButtonStyle}"
                    Padding="14,6"
                    Margin="0"
                    MinWidth="120"
                    MinHeight="32"
                    Height="32"
                    VerticalAlignment="Center"
                    Click="Apply_Click"/>
        </Grid>

        <Border x:Name="ErrorPanel"
                Grid.Row="2"
                Style="{StaticResource ChangeCardStyle}"
                Margin="0,0,0,8"
                Visibility="Collapsed">
            <TextBlock x:Name="TbError"
                       Foreground="#FF6B6B"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="LvLevels"
                  Grid.Row="3"
                  Style="{StaticResource DarkDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DarkDataGridCellStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalScrollBarVisibility="Auto"
                  CellEditEnding="Levels_CellEditEnding">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Имя уровня"
                                    Binding="{Binding LevelName, Mode=OneWay}"
                                    Width="*"
                                    MinWidth="120"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Помещений"
                                    Binding="{Binding RoomCountText, Mode=OneWay}"
                                    Width="80"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTemplateColumn Header="Зона" Width="260" MinWidth="180">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ComboBox Style="{StaticResource DarkComboBoxStyle}"
                                      ItemsSource="{Binding ZoneOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding SelectedZone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      DisplayMemberPath="DisplayName"
                                      Margin="2,1"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Площадь зоны"
                                    Binding="{Binding ZoneAreaText, Mode=OneWay}"
                                    Width="100"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="N_Площадь этажа"
                                    Binding="{Binding FloorAreaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="120"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Проверка"
                                    Binding="{Binding ErrorText, Mode=OneWay}"
                                    Width="180"
                                    IsReadOnly="True"
                                    ElementStyle="{StaticResource ErrorCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
