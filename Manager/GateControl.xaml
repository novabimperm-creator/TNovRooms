<UserControl x:Class="TNovRooms.Manager.GateControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TNovRooms.Manager"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- В общей теме нет редактируемого ComboBox (шаблон без PART_EditableTextBox),
                 поэтому для ввода произвольного «Назначения» описываем его здесь. -->
            <Style x:Key="EditableDarkComboBoxStyle" TargetType="ComboBox">
                <Setter Property="IsEditable" Value="True"/>
                <Setter Property="StaysOpenOnEdit" Value="True"/>
                <Setter Property="IsTextSearchEnabled" Value="False"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Background" Value="{StaticResource BgBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource TreeToggleBorderBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="6,2"/>
                <Setter Property="MinHeight" Value="26"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Margin" Value="2"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItemStyle}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <Border x:Name="border"
                                        CornerRadius="8"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="PART_EditableTextBox"
                                                 Grid.Column="0"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 CaretBrush="White"
                                                 SelectionBrush="{StaticResource SelectedBrush}"
                                                 Padding="{TemplateBinding Padding}"
                                                 VerticalContentAlignment="Center"/>
                                        <ToggleButton Grid.Column="1"
                                                      Focusable="False"
                                                      ClickMode="Press"
                                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                            <ToggleButton.Template>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border Background="Transparent" Padding="7,0">
                                                        <TextBlock Text="▾"
                                                                   Foreground="White"
                                                                   FontSize="12"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </ToggleButton.Template>
                                        </ToggleButton>
                                    </Grid>
                                </Border>
                                <Popup x:Name="PART_Popup"
                                       Placement="Bottom"
                                       IsOpen="{TemplateBinding IsDropDownOpen}"
                                       AllowsTransparency="True"
                                       Focusable="False"
                                       PopupAnimation="Slide">
                                    <Border Background="{StaticResource CardBrush}"
                                            CornerRadius="10"
                                            BorderBrush="{StaticResource SelectedBrush}"
                                            BorderThickness="1"
                                            Padding="3"
                                            MinWidth="{TemplateBinding ActualWidth}"
                                            MaxHeight="240">
                                        <ScrollViewer SnapsToDevicePixels="True">
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Contained"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="StatusCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsComplete}" Value="False">
                        <Setter Property="Foreground" Value="#FF6B6B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="TbStageTitle"
                       Style="{StaticResource PanelHeaderStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="TbStageSubtitle"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="1">

            <!-- Этап 1: неразмещённые и избыточные помещения -->
            <Grid x:Name="PanelUnplaced">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ChangeCardStyle}">
                    <TextBlock x:Name="TbUnplacedInfo"
                               Foreground="White"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <DataGrid x:Name="LvUnplaced"
                          Grid.Row="1"
                          Style="{StaticResource DarkDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DarkDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding IdText}" Width="90"
                                            ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                        <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="90"
                                            ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                        <DataGridTextColumn Header="Имя" Binding="{Binding Name}" Width="*" MinWidth="120"
                                            ElementStyle="{StaticResource WrapCellTextStyle}"/>
                        <DataGridTextColumn Header="Уровень" Binding="{Binding LevelName}" Width="200"
                                            ElementStyle="{StaticResource WrapCellTextStyle}"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="1"
                            Content="Отмена — закрыть плагин"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="0"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="3"
                            Content="Удалить и продолжить"
                            Style="{StaticResource RunButtonStyle}"
                            Margin="0"
                            Click="DeleteUnplaced_Click"/>
                </Grid>
            </Grid>

            <!-- Этап 2: заполнение параметра «Назначение» -->
            <Grid x:Name="PanelDepartment" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource ChangeCardStyle}">
                    <TextBlock x:Name="TbDepartmentInfo"
                               Foreground="White"
                               FontSize="12"
                               TextWrapping="Wrap"/>
                </Border>

                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="2,0,0,10">
                    <CheckBox x:Name="ChkOnlyEmpty"
                              Content="Только незаполненные группы"
                              Style="{StaticResource DarkCheckBoxStyle}"
                              IsChecked="True"
                              Margin="0,0,20,0"
                              Checked="OnlyEmpty_Changed"
                              Unchecked="OnlyEmpty_Changed"/>
                    <CheckBox x:Name="ChkOverwrite"
                              Content="Перезаписывать уже заполненные значения"
                              Style="{StaticResource DarkCheckBoxStyle}"/>
                </StackPanel>

                <DataGrid x:Name="LvDepartments"
                          Grid.Row="2"
                          Style="{StaticResource DarkDataGridStyle}"
                          ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                          CellStyle="{StaticResource DarkDataGridCellStyle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          SelectionUnit="Cell"
                          RowHeight="34"
                          HorizontalScrollBarVisibility="Disabled">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Имя помещения" Binding="{Binding RoomName}" Width="*" MinWidth="140"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource WrapCellTextStyle}"/>
                        <DataGridTextColumn Header="Кол-во" Binding="{Binding CountText}" Width="70"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                        <DataGridTextColumn Header="Текущее «Назначение»" Binding="{Binding CurrentValuesText}" Width="200"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource WrapCellTextStyle}"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="150"
                                            IsReadOnly="True"
                                            ElementStyle="{StaticResource StatusCellTextStyle}"/>
                        <DataGridTemplateColumn Header="Задать «Назначение»" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox Style="{StaticResource EditableDarkComboBoxStyle}"
                                              ItemsSource="{Binding DepartmentOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              Text="{Binding SelectedDepartment, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Grid Grid.Row="3" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TbDepartmentHint"
                               Grid.Column="0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"
                               Margin="2,0,12,0"/>
                    <Button Grid.Column="1"
                            Content="Отмена — закрыть плагин"
                            Style="{StaticResource CloseButtonStyle}"
                            Margin="0"
                            Click="Cancel_Click"/>
                    <Button Grid.Column="3"
                            Content="Применить и продолжить"
                            Style="{StaticResource RunButtonStyle}"
                            Margin="0"
                            Click="ApplyDepartments_Click"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
