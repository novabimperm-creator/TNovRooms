<UserControl x:Class="TNovRooms.Manager.ApartsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:TNovRooms.Manager"
             mc:Ignorable="d"
             d:DesignHeight="560" d:DesignWidth="960"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>

            <Style x:Key="ErrorCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource WrapCellTextStyle}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Foreground" Value="#FF6B6B"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🏠 Квартирография"
                       Style="{StaticResource PanelHeaderStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Расчёт параметров квартир по помещениям с включённым N_Квартира: площади, количество комнат и признак поквартирной сетки."
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource ChangeCardStyle}" Margin="0,0,0,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkReround"
                          Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                          Content="Переокруглить площади помещений квартир"
                          Style="{StaticResource DarkCheckBoxStyle}"
                          VerticalAlignment="Center"
                          Margin="0,0,12,8"/>

                <ToggleButton x:Name="TglSettings"
                              Grid.Row="0" Grid.Column="4"
                              Content="Настройки коэффициентов"
                              Style="{StaticResource FilterToggleStyle}"
                              Margin="0,0,8,8"
                              Padding="10,6"
                              Checked="Settings_Toggled"
                              Unchecked="Settings_Toggled"/>
                <Button x:Name="BtnRecalc"
                        Grid.Row="0" Grid.Column="5"
                        Content="Пересчитать"
                        Style="{StaticResource RunButtonStyle}"
                        Padding="18,6"
                        Margin="0,0,0,8"
                        MinWidth="130"
                        Click="Recalculate_Click"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Номер первой квартиры:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbFirstNumber"
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource DarkCompactTextBoxStyle}"
                         Width="70"
                         Height="28"
                         TextAlignment="Center"
                         Margin="0,0,8,0"
                         TextChanged="FirstNumber_TextChanged"/>
                <Button x:Name="BtnRenumber"
                        Grid.Row="1" Grid.Column="2"
                        Content="Пересчитать сквозные номера"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        Click="Renumber_Click"/>
                <TextBlock x:Name="TbRenumberHint"
                           Grid.Row="1" Grid.Column="3" Grid.ColumnSpan="3"
                           Style="{StaticResource CardSubtitleStyle}"
                           TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <Border x:Name="SettingsPanel"
                Grid.Row="2"
                Style="{StaticResource ChangeCardStyle}"
                Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0"
                           Text="Коэффициент 0.5, имена:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <TextBox Grid.Row="0" Grid.Column="1"
                         Text="{Binding Settings.k05, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkCompactTextBoxStyle}"
                         Height="28"
                         Margin="0,0,8,6"/>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Коэффициент 0.3, имена:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,6"/>
                <TextBox Grid.Row="1" Grid.Column="1"
                         Text="{Binding Settings.k03, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource DarkCompactTextBoxStyle}"
                         Height="28"
                         Margin="0,0,8,6"/>

                <Button Grid.Row="0" Grid.Column="2" Grid.RowSpan="2"
                        Content="Применить"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="14,6"
                        VerticalAlignment="Top"
                        Click="ApplySettings_Click"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                           Text="Эти же имена делят площадь квартиры на «Площадь» и «Балконы»: помещение с коэффициентом попадает в балконы. Настройки общие с Округлятором и Офисографией."
                           Style="{StaticResource CardSubtitleStyle}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,8,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Этаж:"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="CbLevelFilter"
                      Grid.Column="1"
                      Style="{StaticResource DarkComboBoxStyle}"
                      Margin="0"
                      Padding="10,6"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="LevelFilter_SelectionChanged"/>
            <CheckBox x:Name="ChkErrorsOnly"
                      Grid.Column="2"
                      Content="Только с ошибками"
                      Style="{StaticResource DarkCheckBoxStyle}"
                      VerticalAlignment="Center"
                      Margin="12,0,0,0"
                      Checked="ErrorsOnly_Changed"
                      Unchecked="ErrorsOnly_Changed"/>
            <Button Grid.Column="4"
                    Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="14,6"
                    Click="Reload_Click"/>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource ChangeCardStyle}" Margin="0,0,0,8">
            <TextBlock x:Name="TbSummary"
                       Foreground="White"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <DataGrid x:Name="LvAparts"
                  Grid.Row="5"
                  Style="{StaticResource DarkDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DarkDataGridCellStyle}"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HeadersVisibility="Column"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HorizontalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Сквозной №" Binding="{Binding NumberDisplay}" Width="90"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="№ на этаже" Binding="{Binding NumberAtLevelText}" Width="85"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Этаж" Binding="{Binding LevelText}" Width="60"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Пом." Binding="{Binding RoomsTotal}" Width="50"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Комнат" Binding="{Binding LivingRoomsCountText}" Width="60"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Общая" Binding="{Binding AreaTotalText}" Width="70"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Общая с к" Binding="{Binding AreaTotalKText}" Width="80"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Площадь" Binding="{Binding AreaText}" Width="70"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Балконы" Binding="{Binding AreaBalconyText}" Width="70"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Балк. с к" Binding="{Binding AreaBalconyKText}" Width="70"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Жилая" Binding="{Binding AreaLivingText}" Width="65"
                                    ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                <DataGridTextColumn Header="Проверка" Binding="{Binding ErrorText}" Width="*" MinWidth="200"
                                    ElementStyle="{StaticResource ErrorCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="6" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    Content="Ручной нумератор"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="16,6"
                    Click="ManualNumbering_Click"/>
            <TextBlock Grid.Column="1"
                       Text="Ручной нумератор заполняет N_Кв.НомерНаЭтаже выбором помещений в модели. Менеджер закроется и откроется снова после нумерации."
                       Style="{StaticResource CardSubtitleStyle}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
