<Window x:Class="TNovRooms.RoomsWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:TNovRooms"
        mc:Ignorable="d"
        Width="480"
        SizeToContent="Height"
        d:DataContext="{d:DesignInstance local:RoomsViewModel}"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="КВАРТИРОГРАФИЯ И ОФИСОГРАФИЯ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="Общие настройки"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <TextBlock Text="Помещения с коэффициентом 0,3:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <TextBox Name="textBox3"
                             Text="{Binding k03}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Height="36"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Помещения с коэффициентом 0,5:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <TextBox Name="textBox4"
                             Text="{Binding k05}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             Height="36"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <ToggleButton x:Name="checkBox1"
                                  Style="{StaticResource CardToggleStyle}"
                                  Margin="0"
                                  IsChecked="{Binding recalc}">
                        <TextBlock Text="Переокруглить площади помещений"
                                   Style="{StaticResource CardTitleStyle}"
                                   TextWrapping="Wrap"/>
                    </ToggleButton>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource PanelFrameStyle}"
                    Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Офисография"
                               Style="{StaticResource PanelHeaderStyle}"/>

                    <TextBlock Text="Исключить из полезной и расчетной площади:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <TextBox Name="textBox1"
                             Text="{Binding names1}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             MinHeight="36"
                             VerticalContentAlignment="Top"
                             TextAlignment="Center"
                             TextWrapping="Wrap"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Исключить из расчетной площади:"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               Margin="0,0,0,6"/>
                    <TextBox Name="textBox2"
                             Text="{Binding names2}"
                             Style="{StaticResource DarkTextBoxStyle}"
                             MinHeight="36"
                             VerticalContentAlignment="Top"
                             TextAlignment="Center"
                             TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Content="Отмена"
                        x:Name="escButton"
                        Style="{StaticResource CloseButtonStyle}"
                        IsCancel="True"
                        Click="escButton_Click"
                        Margin="0,44,0,0"/>
                <StackPanel Grid.Column="2">
                    <Button Content="Выбрать и применить"
                            Style="{StaticResource RunButtonStyle}"
                            Margin="0"
                            Command="{Binding Path=scenario2}"
                            Click="acceptButton_Click"/>
                    <Button Content="Применить для всех"
                            x:Name="acceptButton"
                            Style="{StaticResource RunButtonStyle}"
                            Margin="0,6,0,0"
                            Command="{Binding Path=scenario1}"
                            IsDefault="True"
                            Click="acceptButton_Click"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
